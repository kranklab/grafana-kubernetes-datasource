{
  "$schema": "https://raw.githubusercontent.com/grafana/grafana/main/docs/sources/developers/plugins/plugin.schema.json",
  "type": "datasource",
  "name": "Kubernetes Datasource",
  "id": "kranklab-kubernetes-datasource",
  "metrics": true,
  "backend": true,
  "executable": "gpx_kubernetes_datasource",
  "info": {
    "description": "A Grafana backend datasource plugin that queries the Kubernetes API directly, supporting workloads, RBAC, storage, networking, CRDs, and more.",
    "author": {
      "name": "Kranklab"
    },
    "keywords": ["datasource","kubernetes"],
    "logos": {
      "small": "img/logo.svg",
      "large": "img/logo.svg"
    },
    "links": [
      {
        "name": "GitHub",
        "url": "https://github.com/kranklab/grafana-kubernetes-datasource"
      }
    ],
    "screenshots": [
      {
        "name": "Dashboard",
        "path": "img/datasource.png"
      }
    ],
    "version": "%VERSION%",
    "updated": "%TODAY%"
  },
  "dependencies": {
    "grafanaDependency": ">=12.0.0",
    "plugins": []
  }
}
